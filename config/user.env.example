# ============================================================================
#  DeepSeek Harness - user settings
#  start.ps1 / DeepSeekHarness.exe 每次启动都会读这个文件。
#  文法：每行 KEY=VALUE，'#' 起注释，值可用引号包裹。
#
#  ⚠ 本文件是「新机器首次运行」的模板（bootstrap.ps1 会把它拷成 user.env），
#    所以**不要在这里写死盘符**。留空表示自动探测；启动器的「环境配置」页
#    也会在换机后自动把失效的路径重新定位并写回。
# ============================================================================

# (可选) DeepSeek 官方 API Key。
# 获取地址: https://platform.deepseek.com/
#
# ⚠ 也可以不填在这里：推荐在启动器的「环境配置」页填写，那样密钥会用口令派生的
#   密钥加密存放（或本机模式下用 DPAPI 保护），磁盘上不出现明文。
#   若你选择填在这里，启动器首次运行会自动把它迁进加密库，并从本文件抹掉。
DEEPSEEK_API_KEY=

# (可选) Web UI 端口，默认 3080
DSH_PORT=3080

# (可选) 设为 1 时不自动打开浏览器
DSH_NO_OPEN=0

# (可选) 使用系统已安装的 Node.js 而不是便携版 Node（设为 1）
DSH_SYSTEM_NODE=0

# (可选) 额外本地模型端点，自动探测。格式：名称|地址|OpenAI路径前缀
# 多个端点用分号 ; 分隔。示例：
#   内网GPU服务器|http://192.168.1.10:8000|/v1
#   Docker里的Ollama|http://192.168.1.5:11434|/v1
#
# 注意：llama.cpp 的默认端口 11435 不在内置探测表里，若要让本地模型被自动
# 注册，必须在这儿声明一条（与下面的 DSH_LLAMA_PORT 保持一致）：
#   DSH_EXTRA_ENDPOINTS=llama-server|http://127.0.0.1:11435|/v1
DSH_EXTRA_ENDPOINTS=

# (可选) 追加传给 dsh 的额外参数（按空格拆分）
# DSH_EXTRA_ARGS=--no-open

# (可选) dsh 的默认权限模式：read-only / workspace-write / danger-full-access
# 仅在该项为空且 dsh 的 settings.yaml 里尚无权限配置时写入一次（不覆盖你之后的选择）
DSH_PERMISSION=

# ============================================================================
#  本地模型服务自动启动（启动 dsh 前自动拉起推理服务）
#  设为 1 启用；启动脚本会先检查端口是否已被占用，已占用则跳过。
# ============================================================================
DSH_AUTO_START_MODEL=0

# 推理后端类型: llama-cpp 或 ollama
DSH_MODEL_BACKEND=llama-cpp

# --- llama.cpp 配置 ---
# llama-server.exe 所在目录。留空 = 自动探测（常见位置 + 各盘搜索）
DSH_LLAMA_DIR=
# 模型文件路径（GGUF）。留空 = 由「本地模型」页扫描选择
DSH_LLAMA_MODEL=
# 服务端口（需与 DSH_EXTRA_ENDPOINTS 中声明的端口一致）
DSH_LLAMA_PORT=11435
# 上下文长度
DSH_LLAMA_CONTEXT=4096
# GPU 卸载层数（99=全部 offload 到 GPU；0=纯 CPU）
DSH_LLAMA_GPU_LAYERS=99
# 额外参数（如 --flash-attn、--no-mmap 等），留空则不加
DSH_LLAMA_EXTRA_ARGS=

# --- Ollama 配置 ---
# ollama.exe 路径。留空 = 自动探测
DSH_OLLAMA_EXE=
# 启动时预载的模型名（如 qwen2.5:7b），留空则只启动 serve
DSH_OLLAMA_MODEL=
