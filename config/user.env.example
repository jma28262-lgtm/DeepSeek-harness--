# ============================================================================
#  DeepSeek Harness - user settings
#  Copy/edit freely; start.bat reads this file at every launch.
#  Syntax: KEY=VALUE per line, '#' starts a comment, values may be quoted.
# ============================================================================

# (可选) DeepSeek 官方 API Key。填入后会自动配置 DeepSeek 云端模型，
# 并写入 home\.credentials.yaml。不填则只使用本地模型。
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# (可选) Web UI 端口，默认 3080
DSH_PORT=3080

# (可选) 设为 1 时不自动打开浏览器
DSH_NO_OPEN=0

# (可选) 使用系统已安装的 Node.js 而不是便携版 Node（设为 1）
DSH_SYSTEM_NODE=0

# (可选) 额外本地模型端点，自动探测。格式：名称|地址|OpenAI路径前缀
# 多个端点用分号 ; 分隔。示例：
#   内网GPU服务器|http://192.168.1.10:8000|/v1
#   Docker里的Ollama|http://192.168.1.5:11434|/v1
DSH_EXTRA_ENDPOINTS=

# (可选) 追加传给 dsh 的额外参数（按空格拆分）
# DSH_EXTRA_ARGS=--no-open

# ============================================================================
#  本地模型服务自动启动（启动 dsh 前自动拉起推理服务）
#  设为 1 启用；启动脚本会先检查端口是否已被占用，已占用则跳过。
# ============================================================================
DSH_AUTO_START_MODEL=0

# 推理后端类型: llama-cpp 或 ollama
DSH_MODEL_BACKEND=llama-cpp

# --- llama.cpp 配置 ---
# llama-server.exe 所在目录（自动探测 D:\llama.cpp，可手动指定）
DSH_LLAMA_DIR=D:\llama.cpp
# 模型文件路径（GGUF）
DSH_LLAMA_MODEL=D:\Ollama\Models\gguf\Dolphin3.0-Llama3.1-8B-abliterated.Q4_K_M.gguf
# 服务端口（需与 DSH_EXTRA_ENDPOINTS 中声明的端口一致）
DSH_LLAMA_PORT=11435
# 上下文长度
DSH_LLAMA_CONTEXT=4096
# GPU 卸载层数（99=全部 offload 到 GPU；0=纯 CPU）
DSH_LLAMA_GPU_LAYERS=99
# 额外参数（如 --flash-attn、--no-mmap 等），留空则不加
DSH_LLAMA_EXTRA_ARGS=

# --- Ollama 配置 ---
# ollama.exe 路径（自动探测，可手动指定）
DSH_OLLAMA_EXE=D:\Ollama\ollama.exe
# 启动时自动拉取/运行的模型名（如 qwen2.5:7b），留空则只启动 serve
DSH_OLLAMA_MODEL=
